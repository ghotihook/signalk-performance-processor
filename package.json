{
  "name": "signalk-performance-processor",
  "version": "0.2.11",
  "description": "Stops true wind direction swinging every time you tack or gybe. Calibrates true wind in Signal K the way a B&G H5000 does: boat speed, TWA and TWS correction tables fitted from your own sailing logs, then damping, with every step shown live in a webapp.",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-utility",
    "signalk",
    "sailing",
    "racing",
    "true-wind",
    "calibration",
    "leeway",
    "speed-through-water"
  ],
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "Performance Processor",
    "appIcon": "./icon.svg",
    "screenshots": [
      "./docs/screenshots/live.png",
      "./docs/screenshots/calibration-twa.png",
      "./docs/screenshots/calibration-stw.png",
      "./docs/screenshots/calibration-tws.png",
      "./docs/screenshots/live-phone.png",
      "./docs/screenshots/live-dark.png",
      "./docs/screenshots/settings.png"
    ]
  },
  "files": [
    "index.js",
    "icon.svg",
    "lib/",
    "public/",
    "docs/screenshots/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghotihook/signalk-performance-processor.git"
  },
  "homepage": "https://github.com/ghotihook/signalk-performance-processor#readme",
  "bugs": {
    "url": "https://github.com/ghotihook/signalk-performance-processor/issues"
  },
  "author": "ghotihook",
  "license": "MIT"
}
