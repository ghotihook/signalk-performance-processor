{
  "name": "signalk-performance-processor",
  "version": "0.3.3-beta.2",
  "description": "True wind you can trust in Signal K: TWD steady through tacks and gybes, TWS the same upwind and down, TWA at your compass's rate. Works true wind out again from raw apparent wind, boat speed and heading, corrects it with boat speed / heel, TWA and TWS tables of any shape (an H5000 or H2000 calibration, or a fine grid) fitted from your own sailing logs, damps it, and shows every step live. Also leeway, current and ground wind. Runs beside your instruments in Shadow mode until you trust it.",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node scripts/check-publish-tag.js && npm test"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-utility",
    "signalk",
    "sailing",
    "racing",
    "true-wind",
    "calibration",
    "leeway",
    "speed-through-water"
  ],
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "Performance Processor",
    "appIcon": "./icon.svg",
    "screenshots": [
      "./docs/screenshots/live.png",
      "./docs/screenshots/calibration-twa.png",
      "./docs/screenshots/calibration-stw.png",
      "./docs/screenshots/calibration-tws.png",
      "./docs/screenshots/live-phone.png",
      "./docs/screenshots/live-dark.png",
      "./docs/screenshots/settings.png"
    ]
  },
  "files": [
    "index.js",
    "icon.svg",
    "lib/",
    "public/",
    "docs/screenshots/",
    "AGENTS.md",
    "CHANGELOG.md",
    "SPECIFICATION.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghotihook/signalk-performance-processor.git"
  },
  "homepage": "https://github.com/ghotihook/signalk-performance-processor#readme",
  "bugs": {
    "url": "https://github.com/ghotihook/signalk-performance-processor/issues"
  },
  "author": "ghotihook",
  "license": "MIT"
}
